<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:fitsSystemWindows="true"
    android:background="#f4f4f6">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">
        <ImageView android:layout_width="84dp" android:layout_height="84dp"
            android:layout_marginTop="24dp" android:src="@drawable/app_icon"
            android:contentDescription="@string/icon_description" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/app_title"
            android:textSize="26sp" android:textStyle="bold" android:textColor="#071a33"
            android:gravity="center" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/app_intro"
            android:textSize="16sp" android:textColor="#425c76" android:gravity="center" />
        <Button android:id="@+id/configure_address" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:layout_marginTop="20dp" android:text="Configurar endereço"
            android:textSize="16sp" android:textAllCaps="false" android:textColor="#5330b3" />
        <Button android:id="@+id/open_platform" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="52dp"
            android:layout_marginTop="24dp" android:text="@string/open_platform"
            android:textSize="16sp" android:textAllCaps="false" android:textColor="#ffffff"
            android:backgroundTint="#3b4ff5" />
        <Button android:id="@+id/open_browser" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/open_browser" android:textSize="16sp"
            android:textAllCaps="false" android:textColor="#173f67" />
        <Button android:id="@+id/offline_help" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/offline_help" android:textSize="16sp"
            android:textAllCaps="false" android:textColor="#173f67" />
        <TextView android:id="@+id/status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="@string/opening" android:textSize="16sp"
            android:textColor="#425c76" android:accessibilityLiveRegion="polite" />
    </LinearLayout>
</ScrollView>
